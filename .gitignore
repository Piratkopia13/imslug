# Transient agent working documents (plan drafts, session notes, scratch).
# Never committed. Working material (the current plan included) lives in
# .agent-docs/; see AGENTS.md (Docs policy).
.agent-docs/

# Build directories
build/
build-*/
out/
cmake-build-*/

# CMake / tooling state
CMakeUserPresets.json
compile_commands.json

# Node dependencies of the browser smoke (scripts/web_smoke); kept untracked so
# check_docs never scans package READMEs.
scripts/web_smoke/node_modules/

# IDE / editors
.vs/
.vscode/
.idea/

# Generated shader binaries and intermediates.
# NOTE: shaders/imslug_shaders_vulkan.h is generated but committed on purpose.
*.spv

# Local example-app state (Dear ImGui writes these next to the binary)
imgui.ini

# Fetched CJK test font (scripts/fetch_cjk_font.*) and its download cache.
# Provenance, the subset character set and the exact subset command are
# committed in tests/fonts/cjk/ (see PROVENANCE.txt there).
tests/fonts/cjk/*.ttf
tests/fonts/cjk/*.otf
tests/fonts/cjk/.cache/
tests/fonts/cjk/OFL.txt

# Fetched color-emoji test font (scripts/fetch_emoji_font.*); provenance and
# the pinned URL/SHA-256 are committed in tests/fonts/emoji/PROVENANCE.txt.
tests/fonts/emoji/*.ttf
tests/fonts/emoji/.cache/
tests/fonts/emoji/OFL.txt
